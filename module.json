        "metadata": "object",
        "http_status": "number",
        "safety_proof": "object"
      }
    },
    {
      "id": "dropbox.copy",
      "title": "Copy a file or folder to a new path",
      "provider": "dropbox",
      "risk": "high",
      "mode": "write_requires_approval",
      "side_effects": "external",
      "requires": [
        "DROPBOX_API_KEY"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "from_path": {
          "type": "string",
          "required": true
        },
        "to_path": {
          "type": "string",
          "required": true
        },
        "autorename": {
          "type": "string",
          "required": false
        }
      },
      "output_schema": {
        "metadata": "object",
        "http_status": "number",
        "safety_proof": "object"
