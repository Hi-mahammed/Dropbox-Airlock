      "side_effects": "external",
      "requires": [
        "DROPBOX_API_KEY"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "from_path": {
          "type": "string",
          "required": true
        },
        "to_path": {
          "type": "string",
          "required": true
        },
        "autorename": {
          "type": "string",
          "required": false
        }
