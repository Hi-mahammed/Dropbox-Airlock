        "safety_proof": "object"
      }
    },
    {
      "id": "dropbox.create_shared_link",
      "title": "Create a shared link for a file or folder",
      "provider": "dropbox",
      "risk": "high",
      "mode": "write_requires_approval",
      "side_effects": "external",
      "requires": [
        "DROPBOX_API_KEY"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "path": {
          "type": "string",
          "required": true
