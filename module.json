      "provider": "dropbox",
      "risk": "high",
      "mode": "write_requires_approval",
      "side_effects": "external",
      "requires": [
        "DROPBOX_API_KEY"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "path": {
          "type": "string",
          "required": true
        }
      },
      "output_schema": {
        "metadata": "object",
        "http_status": "number",
        "safety_proof": "object"
      }
    },
    {
